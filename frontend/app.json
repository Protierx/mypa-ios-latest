{
  "expo": {
    "name": "MYPA iOS App",
    "slug": "mypa-app",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#7C3AED",
      "iosDisplayInForeground": true
    },
    "plugins": [
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      ["./plugins/withPorcupineKeyword", {
        "keywords": ["hey-my-low_en_ios_v4_0_0.ppn"]
      }],
      ["@sentry/react-native/expo", {
        "organization": "REPLACE_WITH_SENTRY_ORG",
        "project": "REPLACE_WITH_SENTRY_PROJECT"
      }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mypatesting.mypa",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "MYPA needs microphone access for voice conversations with your AI assistant.",
        "UIBackgroundModes": [
          "fetch",
          "processing",
          "audio",
          "voip"
        ]
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.mypatesting.mypa"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "afe64d01-5928-4966-8026-4cc0833ee9a2"
      }
    },
    "owner": "mypa-testing"
  }
}
