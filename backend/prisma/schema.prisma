// Prisma Schema for Mylo Backend
// Run: npx prisma db push (to sync with database)
// NOTE: Using SQLite for local development. Switch to PostgreSQL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// ==========================================
// USER & AUTH
// ==========================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  username      String?  @unique
  name          String?
  avatarUrl     String?
  bio           String?
  
  // Gamification
  xp            Int      @default(0)
  level         Int      @default(1)
  totalTimeSaved Int     @default(0)
  
  // Streaks
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveDate DateTime?
  
  // Stats
  tasksCompleted   Int   @default(0)
  focusMinutes     Int   @default(0)
  challengesWon    Int   @default(0)
  
  // Settings
  timezone         String @default("UTC")
  dailyGoalMinutes Int    @default(120)
  
  // Status
  isActive      Boolean  @default(true)
  isOnboarded   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  refreshTokens RefreshToken[]
  tasks         Task[]
  focusSessions FocusSession[]
  brainDumpItems BrainDumpItem[]
  
  // Circles
  ownedCircles    Circle[]       @relation("CircleOwner")
  circleMemberships CircleMember[]
  assignmentsCreated Assignment[] @relation("AssignmentCreator")
  assignmentsReceived Assignment[] @relation("AssignmentAssignee")
  invitationsSent     CircleInvitation[] @relation("InvitationsSent")
  invitationsReceived CircleInvitation[] @relation("InvitationsReceived")
  
  // Social
  posts         Post[]
  reactions     Reaction[]
  challengeParticipations ChallengeParticipant[]
  
  // Achievements & Notifications
  achievements  UserAchievement[]
  notifications Notification[]
  savedPlaces   SavedPlace[]
  
  // Settings
  settings      UserSettings?
  
  // Google integration
  googleRefreshToken String?
  googleConnectedAt  DateTime?
  
  // AI Learning System relations
  userModel         UserModel?
  userUnlocks       UserUnlock[]
  userEvents        UserEvent[]
  conversations     Conversation[]
  
  // Recurring tasks
  recurringTemplates RecurringTaskTemplate[]
  
  // Calendar integration
  calendarConnections CalendarConnection[]
  calendarEvents      CalendarEvent[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@map("refresh_tokens")
}

model UserSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notifications - General
  pushEnabled         Boolean @default(true)
  emailNotifications  Boolean @default(true)
  remindersBefore     Int     @default(15)
  
  // Notifications - Types
  taskReminders       Boolean @default(true)
  assignmentAlerts    Boolean @default(true)
  streakReminders     Boolean @default(true)
  dailyBriefing       Boolean @default(true)
  levelUpAlerts       Boolean @default(true)
  challengeUpdates    Boolean @default(true)
  circleActivity      Boolean @default(true)
  aiInsights          Boolean @default(true)
  weeklyDigest        Boolean @default(true)
  
  // Notifications - Delivery
  soundEnabled        Boolean @default(true)
  vibrationEnabled    Boolean @default(true)
  badgeEnabled        Boolean @default(true)
  
  // Notifications - Quiet Hours
  quietHoursEnabled   Boolean @default(false)
  quietHoursStart     String  @default("22:00")
  quietHoursEnd       String  @default("08:00")
  
  // Voice
  voiceLanguage       String  @default("en")
  voiceSpeed          String  @default("normal")
  voiceName           String  @default("nova")
  
  // Privacy
  profilePublic       Boolean @default(true)
  showStreak          Boolean @default(true)
  showLevel           Boolean @default(true)
  
  // Focus
  focusSessionDefault Int     @default(25)
  breakDuration       Int     @default(5)
  longBreakDuration   Int     @default(15)
  sessionsBeforeLongBreak Int @default(4)
  
  // Theme
  theme               String  @default("system")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

// ==========================================
// TASKS & PRODUCTIVITY
// ==========================================

model Task {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  
  // Scheduling
  date        String?
  time        String?
  durationMin Int       @default(30)
  isFixed     Boolean   @default(false)
  
  // Organization
  category    String    @default("Personal")
  priority    String    @default("NORMAL")
  tags        String    @default("[]")
  
  // AI metadata
  aiCategorized Boolean @default(false)
  aiSuggestions String?
  aiEstimatedMinutes Int?
  
  // Recurring task support
  isRecurring           Boolean  @default(false)
  recurringTemplateId   String?
  recurringTemplate     RecurringTaskTemplate? @relation("RecurringTaskInstances", fields: [recurringTemplateId], references: [id], onDelete: SetNull)
  recurrenceInstanceDate DateTime?  // Which date this instance represents
  
  // Status
  completed   Boolean   @default(false)
  completedAt DateTime?
  
  // Gamification
  xpAwarded   Int       @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  focusSessions FocusSession[]
  assignment    Assignment?

  @@map("tasks")
}

model FocusSession {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  // Timing
  startedAt      DateTime @default(now())
  endedAt        DateTime?
  targetMinutes  Int      @default(25)
  actualMinutes  Int      @default(0)
  
  // Status: ACTIVE, PAUSED, COMPLETED, ABANDONED
  status         String   @default("ACTIVE")
  pausedAt       DateTime?
  totalPausedSec Int      @default(0)
  
  // Meta
  category       String?
  notes          String?
  
  // Gamification
  xpAwarded      Int      @default(0)
  
  createdAt      DateTime @default(now())

  @@map("focus_sessions")
}

model BrainDumpItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content   String
  
  // AI processing
  processed    Boolean  @default(false)
  aiCategory   String?
  aiPriority   String?
  aiSuggestion String?
  
  // Conversion
  convertedToTaskId String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brain_dump_items")
}

// ==========================================
// CIRCLES (SOCIAL ACCOUNTABILITY)
// ==========================================

model Circle {
  id          String   @id @default(uuid())
  name        String
  description String?
  emoji       String   @default("👥")
  color       String   @default("#8B5CF6")
  
  // Owner
  ownerId     String
  owner       User     @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Settings
  isPrivate   Boolean  @default(false)
  inviteCode  String   @unique @default(uuid())
  maxMembers  Int      @default(20)
  
  // Stats
  totalXp     Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  members     CircleMember[]
  assignments Assignment[]
  posts       Post[]
  challenges  Challenge[]
  invitations CircleInvitation[]

  @@map("circles")
}

model CircleMember {
  id       String   @id @default(uuid())
  circleId String
  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Role: OWNER, ADMIN, MEMBER
  role     String   @default("MEMBER")
  
  // Stats within circle
  xpContributed Int @default(0)
  tasksCompleted Int @default(0)
  
  joinedAt DateTime @default(now())
  
  @@unique([circleId, userId])
  @@map("circle_members")
}

// ==========================================
// CIRCLE INVITATIONS
// ==========================================

model CircleInvitation {
  id         String   @id @default(uuid())
  circleId   String
  circle     Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  
  // Who sent the invite
  inviterId  String
  inviter    User     @relation("InvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  
  // Who is being invited
  inviteeId  String
  invitee    User     @relation("InvitationsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  
  // Status: PENDING, ACCEPTED, DECLINED, EXPIRED
  status     String   @default("PENDING")
  
  // Optional message
  message    String?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  expiresAt  DateTime?
  
  @@unique([circleId, inviteeId])
  @@map("circle_invitations")
}

// ==========================================
// ASSIGNMENTS (CIRCLE TASKS)
// ==========================================

model Assignment {
  id          String   @id @default(uuid())
  circleId    String
  circle      Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  
  // Who created / assigned
  creatorId   String
  creator     User     @relation("AssignmentCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  
  // Who it's assigned to
  assigneeId  String
  assignee    User     @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  
  // Task link (optional)
  taskId      String?  @unique
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  
  // Assignment details
  title       String
  description String?
  dueDate     DateTime?
  
  // Repeat settings
  repeatEnabled   Boolean  @default(false)
  repeatFrequency String?  // daily, weekly, monthly
  
  // Proof requirement
  requireProof    Boolean  @default(false)
  
  // Status: PENDING, ACCEPTED, DECLINED, COMPLETED, EXPIRED
  status      String   @default("PENDING")
  acceptedAt  DateTime?
  completedAt DateTime?
  declineReason String?
  
  // Edit tracking
  isEdited    Boolean  @default(false)
  editedAt    DateTime?
  editedChanges String?  // JSON array of what was changed
  
  // Proof
  proofUrl    String?
  proofNote   String?
  
  // Gamification
  xpReward    Int      @default(50)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("assignments")
}

// ==========================================
// POSTS (CIRCLE FEED)
// ==========================================

model Post {
  id        String   @id @default(uuid())
  circleId  String
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // Type: DAILY_CARD, ACHIEVEMENT, MILESTONE, SYSTEM, TEXT
  type      String   @default("DAILY_CARD")
  content   String?
  imageUrl  String?
  
  // Daily Card specific
  tasksCompleted Int?
  focusMinutes   Int?
  streakDay      Int?
  
  createdAt DateTime @default(now())
  
  // Relations
  reactions Reaction[]

  @@map("posts")
}

model Reaction {
  id      String @id @default(uuid())
  postId  String
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  emoji   String @default("🔥")
  
  createdAt DateTime @default(now())
  
  @@unique([postId, userId])
  @@map("reactions")
}

// ==========================================
// CHALLENGES
// ==========================================

model Challenge {
  id          String   @id @default(uuid())
  circleId    String?
  circle      Circle?  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  emoji       String   @default("🏆")
  
  // Type: FOCUS_MINUTES, TASKS_COMPLETED, STREAK_DAYS, CUSTOM
  type        String   @default("FOCUS_MINUTES")
  targetValue Int      @default(100)
  
  // Timing
  startsAt    DateTime
  endsAt      DateTime
  
  // Rewards
  xpReward    Int      @default(100)
  
  // Status
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  
  // Relations
  participants ChallengeParticipant[]

  @@map("challenges")
}

model ChallengeParticipant {
  id           String    @id @default(uuid())
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  progress     Int       @default(0)
  rank         Int?
  
  joinedAt     DateTime  @default(now())
  completedAt  DateTime?
  
  @@unique([challengeId, userId])
  @@map("challenge_participants")
}

// ==========================================
// ACHIEVEMENTS
// ==========================================

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  
  name        String
  description String
  emoji       String
  
  // Type: TASKS_COMPLETED, STREAK_DAYS, FOCUS_MINUTES, LEVEL_REACHED, etc.
  type        String
  threshold   Int      @default(1)
  
  // Reward
  xpReward    Int      @default(50)
  
  // Display
  isHidden    Boolean  @default(false)
  
  // Relations
  users       UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  unlockedAt    DateTime    @default(now())
  
  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Type: REMINDER, ASSIGNMENT, CIRCLE_INVITE, CHALLENGE, ACHIEVEMENT, STREAK, SYSTEM
  type      String
  title     String
  body      String
  data      String?
  
  read      Boolean  @default(false)
  readAt    DateTime?
  
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ==========================================
// SAVED PLACES
// ==========================================

model SavedPlace {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name      String
  address   String?
  latitude  Float
  longitude Float
  
  icon      String   @default("📍")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_places")
}

// ==========================================
// PUSH TOKENS
// ==========================================

model PushToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  platform  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_tokens")
}

// ==========================================
// SCHEDULED NOTIFICATIONS
// ==========================================

model ScheduledNotification {
  id           String   @id @default(uuid())
  userId       String
  
  title        String
  body         String
  data         String?
  
  scheduledFor DateTime
  status       String   @default("PENDING") // PENDING, SENT, CANCELLED
  sentAt       DateTime?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("scheduled_notifications")
}

// ==========================================
// AI LEARNING SYSTEM (Mylo Intelligence)
// ==========================================

model UserModel {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Learned peak productivity hours (JSON array of hour numbers 0-23)
  peakHours           String   @default("[]")
  
  // Best day of week for different activities (0-6, Sun-Sat)
  bestDayForPlanning  Int?
  bestDayForFocus     Int?
  bestDayForTasks     Int?
  
  // Productivity patterns (JSON)
  patterns            String   @default("{}")
  
  // Task duration estimates (JSON: category -> avg minutes)
  durationEstimates   String   @default("{}")
  
  // Category preferences (JSON: weighted list)
  categoryPreferences String   @default("[]")
  
  // Streak behavior
  streakMaintenanceScore Float @default(0.5)
  
  // Focus session patterns
  avgFocusDuration    Int?
  preferredFocusTime  String?
  
  // Voice command patterns
  commonCommands      String   @default("[]")
  
  // Confidence scores (0-1)
  peakHoursConfidence Float    @default(0)
  patternConfidence   Float    @default(0)
  
  // Learning metadata
  totalEventsAnalyzed Int      @default(0)
  lastAnalyzedAt      DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("user_models")
}

model UserUnlock {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Feature identifier (e.g., "peak_hours", "smart_scheduling", "pattern_insights")
  feature     String
  
  // How it was unlocked: TIME (day X), MILESTONE (completed Y), HYBRID
  unlockType  String   @default("TIME")
  
  // Day number when time-unlock became available
  availableAtDay Int?
  
  // Milestone that triggered unlock (if applicable)
  milestoneTrigger String?
  
  // When the feature was actually unlocked
  unlockedAt  DateTime @default(now())
  
  // Whether user has seen the celebration modal
  seenByUser  Boolean  @default(false)
  seenAt      DateTime?
  
  @@unique([userId, feature])
  @@index([seenByUser])
  @@map("user_unlocks")
}

model UserEvent {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Event type (app_opened, task_created, task_completed, focus_started, etc.)
  type        String
  
  // Screen where event occurred
  screen      String?
  
  // Additional metadata (JSON)
  metadata    String   @default("{}")
  
  // Timestamp with timezone info
  timestamp   DateTime @default(now())
  
  // Session tracking
  sessionId   String?
  
  // For batching analysis
  processed   Boolean  @default(false)
  processedAt DateTime?
  
  @@index([userId, timestamp])
  @@index([userId, type])
  @@index([processed])
  @@map("user_events")
}

model Conversation {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // User's input (voice transcription or text)
  userInput   String
  
  // AI's response
  aiResponse  String
  
  // Parsed intent (if applicable)
  intent      String?
  
  // Action taken (if any)
  action      String?
  actionData  String?
  
  // Response time in ms
  responseTimeMs Int?
  
  // User feedback
  isHelpful   Boolean?
  feedbackAt  DateTime?
  
  // Voice-specific metadata
  isVoice     Boolean  @default(false)
  voiceDurationMs Int?
  
  createdAt   DateTime @default(now())
  
  @@index([userId, createdAt])
  @@map("conversations")
}

// ==========================================
// RECURRING TASKS
// ==========================================

model RecurringTaskTemplate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  category    String   @default("Personal")
  priority    String   @default("NORMAL")
  durationMin Int      @default(30)
  
  // Recurrence rule (RRULE format or simplified)
  // e.g., "FREQ=DAILY", "FREQ=WEEKLY;BYDAY=MO,WE,FR", "FREQ=MONTHLY;BYMONTHDAY=15"
  recurrenceRule String
  
  // Simplified recurrence fields for easy querying
  frequency   String   // DAILY, WEEKLY, MONTHLY, YEARLY
  interval    Int      @default(1)  // Every X days/weeks/months
  daysOfWeek  String?  // JSON array [0,1,2,3,4,5,6] for weekly
  dayOfMonth  Int?     // For monthly
  
  // Time of day
  defaultTime String?  // "09:00"
  
  // End conditions
  endDate     DateTime?
  endAfterOccurrences Int?
  occurrencesGenerated Int @default(0)
  
  // Status
  isActive    Boolean  @default(true)
  pausedAt    DateTime?
  
  // Last generated instance
  lastGeneratedDate DateTime?
  nextDueDate DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Generated task instances
  instances   Task[]   @relation("RecurringTaskInstances")

  @@index([userId, isActive])
  @@index([nextDueDate])
  @@map("recurring_task_templates")
}

// ==========================================
// CALENDAR INTEGRATION
// ==========================================

model CalendarConnection {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Provider: GOOGLE, APPLE, OUTLOOK
  provider      String
  
  // OAuth tokens (encrypted in production)
  accessToken   String
  refreshToken  String?
  tokenExpiresAt DateTime?
  
  // Connected calendar IDs (JSON array)
  calendarIds   String   @default("[]")
  
  // Sync settings
  syncEnabled   Boolean  @default(true)
  lastSyncedAt  DateTime?
  syncErrors    String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, provider])
  @@map("calendar_connections")
}

model CalendarEvent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // External reference
  externalId    String
  provider      String
  calendarId    String
  
  // Event details
  title         String
  description   String?
  location      String?
  
  // Timing
  startTime     DateTime
  endTime       DateTime
  isAllDay      Boolean  @default(false)
  timezone      String?
  
  // Status
  status        String   @default("confirmed")  // confirmed, tentative, cancelled
  
  // Sync metadata
  lastSyncedAt  DateTime @default(now())
  etag          String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, externalId, provider])
  @@index([userId, startTime])
  @@map("calendar_events")
}
